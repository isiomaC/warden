{
  "name": "@stlw/warden-cli",
  "version": "0.2.1",
  "description": "Developer CLI for Warden — init, start, audit, policy test, scan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": {
    "warden": "dist/src/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isiomaC/warden.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "agent-security",
    "cli",
    "mcp",
    "warden",
    "ai-safety"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stlw/warden": "^0.2.1",
    "@stlw/warden-hook-server": "^0.2.1",
    "@stlw/warden-mcp-gateway": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "citty": "^0.1.6"
  }
}
