{
  "name": "warden",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/hook-server",
    "packages/mcp-gateway",
    "packages/cli",
    "packages/opencode-plugin"
  ],
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.18",
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "incur": "^0.4.10",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/hook-server && npm run build --workspace=packages/mcp-gateway && npm run build --workspace=packages/cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "overrides": {
    "incur": {
      "@modelcontextprotocol/server": "2.0.0-alpha.2"
    }
  }
}
