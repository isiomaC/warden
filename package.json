{
  "name": "warden",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/hook-server",
    "packages/mcp-gateway",
    "packages/cli",
    "packages/opencode-plugin"
  ],
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/hook-server && npm run build --workspace=packages/mcp-gateway && npm run build --workspace=packages/cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  }
}
