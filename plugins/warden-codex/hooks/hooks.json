{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/scripts/codex-hook-adapter.mjs", "timeout": 30 }] }],
    "PreToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/scripts/codex-hook-adapter.mjs", "timeout": 30 }] }],
    "PostToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/scripts/codex-hook-adapter.mjs", "timeout": 30 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/scripts/codex-hook-adapter.mjs", "timeout": 30 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/scripts/codex-hook-adapter.mjs", "timeout": 30 }] }]
  }
}
